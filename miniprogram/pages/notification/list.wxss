.notify-page {
  min-height: 100vh;
  background: #f5f6f8;
}

.notify-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx 28rpx;
  background: linear-gradient(180deg, #2563eb 0%, #2258dd 55%, #1d4ed8 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: -32rpx;
}

.notify-head-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
}

.notify-head-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.notify-read-all {
  font-size: 26rpx;
  color: #ffffff;
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 30rpx;
}

.notify-list {
  padding: 56rpx 30rpx 30rpx;
}

.notify-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}
.notify-card.read {
  opacity: 0.62;
}

.card-hover {
  transform: scale(0.985);
}

.notify-dot {
  position: absolute;
  left: 16rpx;
  top: 38rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
}

.notify-main {
  overflow: hidden;
}

.notify-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notify-type {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.type-1 { background: #eff4ff; color: #2563eb; }
.type-2 { background: #fef2f2; color: #ef4444; }
.type-3 { background: #fffbeb; color: #d97706; }
.type-4 { background: #f0f9ff; color: #0284c7; }

.notify-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.notify-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.notify-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #9ca3af;
}

.loading {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 20rpx 0;
}
