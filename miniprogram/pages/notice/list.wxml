<view class="notice-page">
  <view class="notice-list">
    <view class="notice-card anim-item" style="animation-delay: {{index * 60}}ms;" wx:for="{{notices}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="card-hover">
      <view class="notice-mark"></view>
      <view class="notice-main">
        <view class="notice-title ellipsis">{{item.title}}</view>
        <view class="notice-time">{{item.createTime}}</view>
      </view>
      <view class="notice-arrow">›</view>
    </view>

    <view wx:if="{{!loading && notices.length === 0}}" class="empty">
      <text class="empty-icon">📢</text>
      <text class="empty-text">暂无公告</text>
    </view>
  </view>
</view>
