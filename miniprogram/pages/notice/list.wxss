.notice-page {
  min-height: 100vh;
  background: #f5f6f8;
}

.notice-list {
  padding: 30rpx;
}

.notice-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}

.anim-item {
  animation: fadeInUp 0.4s ease both;
}

.card-hover {
  transform: scale(0.985);
}

.notice-mark {
  width: 6rpx;
  height: 40rpx;
  border-radius: 3rpx;
  background: var(--brand-gradient);
  margin-right: 22rpx;
  flex-shrink: 0;
}

.notice-main {
  flex: 1;
  overflow: hidden;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.notice-time {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.notice-arrow {
  color: #d1d5db;
  font-size: 38rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
