.detail-page {
  min-height: 100vh;
  /* 固定栏高 132rpx + 安全区。原来只写死 180rpx，漏了 env() 这一项，
     iPhone（safe≈65rpx）余量只剩 3rpx；补上 env 后两端都稳定留 68rpx */
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  background: #f5f6f8;
}

/* ===== 顶部渐变 hero ===== */
.hero {
  padding: 56rpx 40rpx 80rpx;
  background: linear-gradient(180deg, #2563eb 0%, #2258dd 55%, #1d4ed8 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: -48rpx;
}

.room-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
  animation: fadeInUp 0.5s ease;
}

.hero-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  animation: fadeInUp 0.5s ease 0.1s both;
}

.capacity-pill {
  font-size: 23rpx;
  color: #2563eb;
  background: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 22rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(29, 78, 216, 0.18);
}

.hero-hours {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 18rpx;
}

/* ===== 信息卡 ===== */
.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 32rpx 20rpx;
  padding: 6rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.anim-item {
  animation: fadeInUp 0.45s ease both;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}
.info-item:last-child {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  font-size: 27rpx;
  line-height: 1.5;
  color: #6c7486;
}

/* 单行值：保持右对齐，和标签形成两列 */
.info-value {
  font-size: 27rpx;
  color: #1f2937;
  text-align: right;
  max-width: 502rpx;
  line-height: 1.5;
  min-width: 0;
  word-break: break-word;
  overflow-wrap: break-word;
}

/* 段落行（备注）：标签独立成行、正文占满整宽并左对齐。
   多行中文若继续右对齐，每行行首位置不同，眼睛每换一行都要重新找起点，
   这是原排版「看着不舒服」的直接原因；堆叠后每行都从同一条左轴起读。 */
.info-item.is-block {
  display: block;
}

.info-item.is-block .info-label {
  display: block;
  font-size: 25rpx;
  line-height: 1.4;
  color: #6c7486;
}

.info-item.is-block .info-value {
  display: block;
  margin-top: 14rpx;
  max-width: none;
  text-align: left;
  color: #4b5563;
  line-height: 1.75;
  /* pre-line：保留后台录入的换行，但不保留连续空格（避免管理员误输入缩进破坏行首左轴） */
  white-space: pre-line;
}

.remark {
  color: #4b5563;
}

/* ===== 底部按钮 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(17, 24, 39, 0.06);
}

.bottom-bar .btn-primary {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 31rpx;
  font-weight: 500;
}
